# ─────────────────────────────────────────────────────────────
# quota-alert-line — ตัวอย่างไฟล์ตั้งค่า
# คัดลอกเป็น .env แล้วเติมค่า:  cp .env.example .env
# ⚠️ อย่า commit .env (มี token)
# ─────────────────────────────────────────────────────────────

# ── แหล่งข้อมูล ───────────────────────────────────────────────
API_BASE_URL=https://hicrew-staging-api.worshipcats.com
REPORT_NAME=quota_alert.pins
PAGE_SIZE=500
NEAR_PCT=70
# แจ้งเมื่อมีการเติม/เปลี่ยนโควตา แม้ระดับใหม่จะต่ำกว่าเกณฑ์ (1 = เปิด, 0 = ปิด)
NOTIFY_QUOTA_CHANGE=1

# ── การยืนยันตัวตน (refresh | logto | token | db) ─────────────
# refresh = ใช้ Refresh Token ของ Logto (แนะนำเมื่อไม่ได้ทำ M2M)
AUTH=refresh

# ── AUTH=logto (M2M) — ใช้เมื่อทำ M2M แล้วเท่านั้น ─────────────
# ⚠️ M2M ต้องมีแถวในตาราง users ที่ auth_user_id = sub ของ token ด้วย
LOGTO_ENDPOINT=https://<tenant>.logto.app
LOGTO_CLIENT_ID=
LOGTO_CLIENT_SECRET=
# ใส่เมื่อ API resource ของ Logto กำหนด scope ไว้
LOGTO_RESOURCE=
LOGTO_SCOPE=

# ── AUTH=refresh (โหมดที่ใช้อยู่) ─────────────────────────────
# REFRESH_VIA=api   -> ให้ backend แลก token ให้ที่ POST {API}/auth/refresh
#                      (backend ถือ client_secret เอง) ✅ แนะนำ ถ้าไม่มี client_secret
# REFRESH_VIA=logto -> เรียก Logto ตรง (ต้องมี LOGTO_CLIENT_SECRET ถ้า app เป็น confidential)
REFRESH_VIA=api
# API_TOKEN_TTL_SEC=2700   # อายุ access token ฝั่งเรา (วินาที) — ตั้งให้ < 1 ชม.
# ต้องมี LOGTO_ENDPOINT + LOGTO_CLIENT_ID (ใช้เมื่อ REFRESH_VIA=logto)
# public client (SPA) = ไม่ต้องใส่ secret; confidential = ใส่ LOGTO_CLIENT_SECRET
# ขั้นแรก: node quota-alert-line.js --set-refresh-token '<token>'
#           (หรือใส่ REFRESH_TOKEN ที่นี่ก็ได้ — สคริปต์จะย้ายไปเก็บในไฟล์ให้)
# REFRESH_TOKEN=
# REFRESH_TOKEN_FILE=/home/sandboxuser/workspace/quota-alert/token-store.json

# AUTH=token (ใช้ทดสอบเร็ว ๆ — token หมดอายุเมื่อไรก็หยุด)
# ACCESS_TOKEN=

# AUTH=db (ต่อ DB ตรง — ต้อง npm install pg)
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# ── LINE Messaging API ────────────────────────────────────────
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=

# ── พฤติกรรมของสคริปต์ ───────────────────────────────────────
# DRY_RUN=1  -> พิมพ์ข้อความลง log ไม่ส่งจริง และไม่บันทึก state
DRY_RUN=0
VERBOSE=0
DISPLAY_TZ=Asia/Bangkok

# ที่เก็บ state (กันแจ้งซ้ำ) — ต้องเขียนได้
STATE_FILE=/var/lib/quota-alert/state.json
LOCK_FILE=/var/lib/quota-alert/.quota-alert.lock
