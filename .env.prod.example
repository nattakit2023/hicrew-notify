# ─────────────────────────────────────────────────────────────
# ตัวอย่างค่าสำหรับทดสอบกับ PRODUCTION
# ใช้คู่กับ: ENV_FILE=.env.prod node quota-alert-line.js ...
# ⚠️ แยกไฟล์ state จาก staging เสมอ (กัน dedupe ปนกัน)
# ─────────────────────────────────────────────────────────────

API_BASE_URL=https://<prod-api-host>            # จาก DevTools ของ Backoffice prod
REPORT_NAME=quota_alert.pins
PAGE_SIZE=500
NEAR_PCT=70
NOTIFY_QUOTA_CHANGE=1

AUTH=refresh
REFRESH_VIA=api
LOGTO_ENDPOINT=https://logto.worshipcats.com
LOGTO_CLIENT_ID=<client id ของ prod backoffice>

# LINE: แนะนำให้ใช้ "กลุ่มทดสอบ" ก่อน อย่าเพิ่งยิงเข้ากลุ่มปฏิบัติการจริง
LINE_CHANNEL_TOKEN=
LINE_GROUP_ID=

# แยกไฟล์สถานะ/โทเคนของ prod ออกจาก staging
STATE_FILE=./state.prod.json
REFRESH_TOKEN_FILE=./token-store.prod.json
LOCK_FILE=./.quota-alert.prod.lock

DISPLAY_TZ=Asia/Bangkok
DRY_RUN=1                                       # เริ่มด้วย dry-run ก่อนเสมอ
VERBOSE=0
